# -- Partie config
client
dev tun
proto udp

# -- Partie IP
remote 192.168.68.51 1194

resolv-retry infinite
nobind
persist-key
persist-tun

# -- Connexion internet

disable-dco
tun-mtu 1400
mssfix 1360

